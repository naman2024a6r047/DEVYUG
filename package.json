{
  "name": "dvyug-workspace",
  "version": "1.0.0",
  "description": "DVYUG - Divine Essentials for Vedic Yield and Universal Goodness",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev:backend": "npm run dev --workspace=dvyug-backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build:backend": "npm run build --workspace=dvyug-backend",
    "build:frontend": "npm run build --workspace=frontend",
    "build:all": "npm run build --workspace=frontend && npm run build --workspace=dvyug-backend",
    "build": "npm run build:all",
    "build:prod": "node scripts/build-deploy.js"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
